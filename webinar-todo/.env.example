# 本番(クラウド)では Vercel の Storage で Postgres(Neon) を作成すると、
# これらの値は自動で設定されます。手動で設定する場合のみ以下を埋めてください。

# アプリ実行時に使う接続URL（プール接続を推奨）
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# スキーマ作成(prisma db push)に使う直結URL（プールを通さない接続）
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
